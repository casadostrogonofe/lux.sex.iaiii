{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && yarn install && REACT_APP_SANITY_PROJECT_ID=8um1375u REACT_APP_SANITY_DATASET=production REACT_APP_SANITY_API_VERSION=2024-01-01 yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo 'install handled in buildCommand'",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "backend/**",
      "excludeFiles": "{backend/tests/**,test_reports/**,memory/**}"
    }
  }
}
